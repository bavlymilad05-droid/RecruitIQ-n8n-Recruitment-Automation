    {
      "parameters": {
        "jsCode": "\n// HEARTBEAT (dead-man's switch): alerts when nothing\n// happened, which no Error Trigger can see.\n// If applications wait in Status \"new\" for too long, the\n// batch workflow is not running.\n\nconst MAX_WAIT_HOURS = 3;\nconst now = DateTime.now().setZone('Africa/Cairo');\n\nconst parse = s => {\n  s = String(s || '').trim();\n\n  for (const f of [\n    'yyyy-MM-dd HH:mm',\n    'yyyy-MM-dd HH:mm:ss',\n    'M/d/yyyy H:mm:ss',\n    'M/d/yyyy H:mm'\n  ]) {\n    const d = DateTime.fromFormat(s, f, {\n      zone: 'Africa/Cairo'\n    });\n\n    if (d.isValid) return d;\n  }\n\n  const t = Date.parse(s);\n\n  return isNaN(t)\n    ? null\n    : DateTime.fromMillis(t);\n};\n\nconst stuck = $input.all()\n  .map(i => i.json)\n  .filter(r =>\n    String(r.Status || '').toLowerCase() === 'new'\n  )\n  .map(r => ({\n    name: r.Name,\n    position: r.Position,\n    applied: parse(r['Applied At'])\n  }))\n  .filter(r =>\n    r.applied &&\n    now.diff(r.applied, 'hours').hours > MAX_WAIT_HOURS\n  );\n\nconst oldestHours = stuck.length\n  ? Math.round(\n      Math.max(\n        ...stuck.map(r =>\n          now.diff(r.applied, 'hours').hours\n        )\n      )\n    )\n  : 0;\n\nreturn [{\n  json: {\n    isStuck: stuck.length > 0,\n    stuckCount: stuck.length,\n    oldestHours,\n    listHtml: stuck.slice(0, 10).map(r =>\n      `<li>${r.name} (${r.position}), applied ${r.applied.toFormat('yyyy-MM-dd HH:mm')}</li>`\n    ).join(''),\n    time: now.toFormat('yyyy-MM-dd HH:mm'),\n    epochMinute: Math.floor(Date.now() / 60000)\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        176
      ],
      "name": "Find Stuck Application"
    }
