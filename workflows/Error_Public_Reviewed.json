    {
      "parameters": {
        "sendTo": "YOUR_SEND_TO",
        "subject": "= [CRITICAL] {{ $('Check Throttle').first().json.workflow }} failed at {{ $('Check Throttle').first().json.node }} ({{ $('Check Throttle').first().json.type }})",
        "message": "= <!DOCTYPE html> <html lang=\"en\"> <head>   <meta charset=\"UTF-8\">   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"> </head>  <body style=\"margin:0;padding:0;background-color:#0b1120;font-family:Arial,Helvetica,sans-serif;\">    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#0b1120;padding:40px 15px;\">     <tr>       <td align=\"center\">          <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;width:100%;background-color:#151e30;border:1px solid #29364d;border-radius:14px;overflow:hidden;\">            <!-- HEADER -->           <tr>             <td style=\"background-color:#251a26;padding:30px;text-align:center;border-bottom:3px solid #ef4444;\">                <div style=\"font-size:14px;font-weight:bold;color:#fca5a5;letter-spacing:3px;\">                 SYSTEM MONITORING               </div>                <h1 style=\"color:#ffffff;font-size:27px;margin:18px 0 8px;\">                 &#9888; CRITICAL WORKFLOW ALERT               </h1>                <p style=\"color:#cbd5e1;font-size:14px;margin:0;\">                 An automation workflow has encountered an error.               </p>              </td>           </tr>            <!-- WORKFLOW NAME -->           <tr>             <td style=\"padding:30px 30px 15px;\">                <p style=\"color:#94a3b8;font-size:12px;letter-spacing:2px;margin:0 0 8px;\">                 AFFECTED WORKFLOW               </p>                <h2 style=\"color:#ffffff;font-size:23px;margin:0;\">                 {{ $json[\"Workflow\"] }}               </h2>                <p style=\"color:#ef4444;font-size:13px;font-weight:bold;margin-top:12px;\">                 &#9679; CRITICAL ERROR DETECTED               </p>              </td>           </tr>            <!-- ERROR DETAILS -->           <tr>             <td style=\"padding:10px 30px 25px;\">                <table width=\"100%\" cellpadding=\"12\" cellspacing=\"0\" border=\"0\" style=\"background-color:#1e293b;border-radius:8px;color:#ffffff;font-size:14px;\">                  <tr>                   <td style=\"color:#94a3b8;width:140px;border-bottom:1px solid #334155;\">                     Failed Node                   </td>                   <td style=\"border-bottom:1px solid #334155;font-weight:bold;\">                     {{ $json[\"Node\"] }}                   </td>                 </tr>                  <tr>                   <td style=\"color:#94a3b8;border-bottom:1px solid #334155;\">                     Error Type                   </td>                   <td style=\"border-bottom:1px solid #334155;\">                     {{ $json[\"Type\"] }}                   </td>                 </tr>                  <tr>                   <td style=\"color:#94a3b8;border-bottom:1px solid #334155;\">                     Severity                   </td>                   <td style=\"border-bottom:1px solid #334155;color:#f87171;font-weight:bold;\">                     {{ ($json[\"Severity\"] || \"critical\").toUpperCase() }}                   </td>                 </tr>                  <tr>                   <td style=\"color:#94a3b8;border-bottom:1px solid #334155;\">                     Execution ID                   </td>                   <td style=\"border-bottom:1px solid #334155;\">                     {{ $json[\"Execution ID\"] }}                   </td>                 </tr>                  <tr>                   <td style=\"color:#94a3b8;\">                     Time                   </td>                   <td>                     {{ $json[\"Time\"] }}                   </td>                 </tr>                </table>              </td>           </tr>            <!-- ERROR MESSAGE -->           <tr>             <td style=\"padding:0 30px 25px;\">                <p style=\"color:#fca5a5;font-size:13px;font-weight:bold;margin-bottom:10px;\">                 ERROR MESSAGE               </p>                <div style=\"background-color:#301e2a;border-left:4px solid #ef4444;padding:18px;border-radius:6px;color:#fecaca;font-size:14px;line-height:1.7;overflow-wrap:anywhere;\">                 {{ $json[\"Message\"] }}               </div>              </td>           </tr>            <!-- SUGGESTED FIX -->           <tr>             <td style=\"padding:0 30px 30px;\">                <p style=\"color:#93c5fd;font-size:13px;font-weight:bold;margin-bottom:10px;\">                 SUGGESTED FIX               </p>                <div style=\"background-color:#172b43;border-left:4px solid #3b82f6;padding:18px;border-radius:6px;color:#dbeafe;font-size:14px;line-height:1.7;white-space:pre-line;\">                 {{ $json[\"Suggested Fix\"] }}               </div>              </td>           </tr>            <!-- ACTION BUTTON -->           <tr>             <td align=\"center\" style=\"padding:0 30px 35px;\">                <a href=\"{{ $json['Execution Link'] }}\"                  style=\"display:inline-block;background-color:#ef4444;color:#ffffff;text-decoration:none;font-size:15px;font-weight:bold;padding:16px 32px;border-radius:8px;\">                 VIEW FAILED EXECUTION               </a>              </td>           </tr>            <!-- FOOTER -->           <tr>             <td style=\"background-color:#0f172a;padding:25px;text-align:center;border-top:1px solid #29364d;\">                <p style=\"color:#94a3b8;font-size:12px;margin:0 0 8px;\">                 Automated Error Monitoring System               </p>                <p style=\"color:#64748b;font-size:11px;margin:0;\">                 Generated automatically by n8n               </p>                <p style=\"color:#64748b;font-size:11px;margin-top:8px;\">                 {{ $now.toFormat('yyyy-MM-dd HH:mm') }}               </p>              </td>           </tr>          </table>        </td>     </tr>   </table>  </body> </html>",
