      "parameters": {
        "jsCode": "\n// DAILY DIGEST: one summary of the last 24 hours plus\n// everything still open\n\nconst num = v => Number(String(v ?? '').replace(/,/g, ''));\nconst nowMin = Math.floor(Date.now() / 60000);\n\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r.Fingerprint);\n\nconst last24 = rows.filter(r => {\n  const minute = num(r['Epoch Minute']);\n  return minute > 0 &&\n    nowMin - minute >= 0 &&\n    nowMin - minute <= 1440;\n});\n\nconst open = rows.filter(r =>\n  String(r.Status || '').toLowerCase() === 'open'\n);\n\nconst count = (list, key) => list.reduce((acc, r) => {\n  const value = String(r[key] || 'unknown');\n  acc[value] = (acc[value] || 0) + 1;\n  return acc;\n}, {});\n\nconst byType = Object.entries(count(last24, 'Type'))\n  .sort((a, b) => b[1] - a[1]);\n\nconst groups = Object.values(open.reduce((acc, r) => {\n  const key = String(r.Fingerprint);\n\n  if (!acc[key]) {\n    acc[key] = {\n      ...r,\n      times: 0\n    };\n  }\n\n  acc[key].times++;\n\n  return acc;\n}, {}));\n\nconst esc = s => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/'/g, '&#39;');\n\nconst total24h = last24.length;\n\nconst critical24h = last24.filter(r =>\n  String(r.Severity || '').toLowerCase() === 'critical'\n).length;\n\nconst openCount = groups.length;\n\nconst hasNews = total24h > 0 || openCount > 0;\n\nconst typeListHtml = byType.map(([t, n]) =>\n  `<li><b>${esc(t)}</b>: ${n}</li>`\n).join('') || '<li>None</li>';\n\nconst openListHtml = groups.map(g => `\n<li>\n  <b>${esc(g.Workflow)}</b> at\n  <b>${esc(g.Node)}</b>\n  (${esc(g.Type)}, ${esc(g.Severity)})\n  &times;${g.times}<br>\n  <span style=\"color:#6b7280;\">\n    ${esc(g.Message)}\n  </span><br>\n  <i>\n    ${esc(g['Suggested Fix'])}\n  </i>\n</li>\n`).join('') || '<li>No open errors</li>';\n\nreturn [{\n  json: {\n    hasNews,\n    total24h,\n    critical24h,\n    openCount,\n    typeListHtml,\n    openListHtml\n  }\n}];\n"
      },
